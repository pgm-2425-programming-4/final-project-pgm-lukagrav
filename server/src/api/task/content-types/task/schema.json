{
  "kind": "collectionType",
  "collectionName": "tasks",
  "info": {
    "singularName": "task",
    "pluralName": "tasks",
    "displayName": "Task"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "blocks",
      "required": false
    },
    "state": {
      "type": "enumeration",
      "enum": [
        "todo",
        "in_progress",
        "ready_for_review",
        "done",
        "backlog"
      ]
    },
    "group": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "PGM3",
        "PGM4"
      ]
    },
    "labels": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::label.label",
      "mappedBy": "tasks"
    }
  }
}
